# =====================================================================
# CONFIGURACIÓN DEL PROYECTO: AGENTE DE ANÁLISIS DEPORTIVO (EPL)
# =====================================================================
# Instrucciones: Copia este archivo como .env y coloca tus claves reales.
# NUNCA subas el archivo .env al repositorio de código ni expongas credenciales.

# ---------------------------------------------------------------------
# 1. API Externa: BALLDONTLIE EPL API V2 (Fase 1)
# ---------------------------------------------------------------------
BALLDONTLIE_API_KEY=tu_api_key_aqui
BALLDONTLIE_BASE_URL=https://api.balldontlie.io/epl/v2
RATE_LIMIT_RPM=5
ALLOW_PAID_ENDPOINTS=False

# ---------------------------------------------------------------------
# 2. Inteligencia Artificial: Google Gemini (Fase 3)
# ---------------------------------------------------------------------
# Clave obtenida de Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL_NAME=gemini-2.5-flash

# ---------------------------------------------------------------------
# 3. Almacenamiento Local (Data Lakehouse)
# ---------------------------------------------------------------------
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
LAKEHOUSE_DB_PATH=data/lakehouse/epl.duckdb
MODELS_DIR=models
KNOWLEDGE_DIR=data/knowledge

# ---------------------------------------------------------------------
# 4. Servidor Web y API REST (Fase 4)
# ---------------------------------------------------------------------
# Para desarrollo local enlazar a 127.0.0.1 (loopback).
# Usar 0.0.0.0 únicamente en despliegue con contenedor Docker o detrás de Reverse Proxy seguro.
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ENABLE_CODE_EXECUTION=False
